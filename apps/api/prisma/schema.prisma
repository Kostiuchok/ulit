generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  AUTHOR
  ADMIN
}

enum BookStatus {
  DRAFT
  PROCESSING
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DistributionStrategy {
  WIDE
  KDP_SELECT
}

enum ExternalStatus {
  NOT_SENT
  SENT
  PUBLISHED
  ERROR
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

enum RoyaltyStatus {
  PENDING
  PAID
}

enum ConversionStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model User {
  id                           String    @id @default(cuid())
  email                        String    @unique
  passwordHash                 String?
  name                         String
  slug                         String    @unique
  bio                          String?
  avatarUrl                    String?
  role                         Role      @default(AUTHOR)
  emailVerified                Boolean   @default(false)
  emailVerificationToken       String?   @unique
  emailVerificationTokenExpiry DateTime?
  contractAcceptedAt           DateTime?
  contractAcceptedIp           String?
  taxId                        String?
  payoutDocument               String?
  bankIban                     String?
  payoutDetailsSubmittedAt     DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  books     Book[]
  orders    Order[]
  royalties Royalty[]
  styleSets AuthorStyleSet[]

  @@index([slug])
  @@index([email])
}

model AuthorStyleSet {
  id             String   @id @default(cuid())
  authorId       String
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  styleOverrides Json
  createdAt      DateTime @default(now())

  @@index([authorId])
}

model Book {
  id                   String               @id @default(cuid())
  slug                 String               @unique
  title                String
  description          String?
  authorId             String
  author               User                 @relation(fields: [authorId], references: [id])
  status               BookStatus           @default(DRAFT)
  moderationStatus     ModerationStatus     @default(PENDING)
  moderationNote       String?
  previousStatus       String? // status before soft-delete, restored on undo
  archivedAt           DateTime? // soft-delete timestamp ("Видалити книгу" — recoverable)
  isbn                 String?              @unique
  coverUrl             String?
  backCoverUrl         String?
  originalDocxUrl      String?
  docxUpdatedAt        DateTime? // set whenever the source .docx changes; compared to publishedAt to know if a live book has unpublished file changes
  republishRequestedAt DateTime? // author submitted post-publish changes for re-moderation; cleared once admin approves or rejects
  pdfUrl               String?
  epubUrl              String?
  fb2Url               String?
  mobiUrl              String?
  printPdfUrl          String?
  priceEbook           Decimal?             @db.Decimal(10, 2) // Е-книга
  pricePrint           Decimal?             @db.Decimal(10, 2) // Друк, м'яка обкладинка
  pricePrintHardcover  Decimal?             @db.Decimal(10, 2) // Друк, тверда обкладинка
  genre                String?
  subtitle             String?
  ageRating            String?
  aiGenerated          Boolean              @default(false)
  aiGeneratedNote      String?
  coAuthors            Json?
  language             String               @default("uk")
  pageCount            Int?
  pagesGeneratedAt     DateTime?
  previewStart         Int?
  previewEnd           Int?
  distributionStrategy  DistributionStrategy @default(WIDE)
  distributionChannels  String[]             @default(["ULIT", "D2D", "KDP", "GOOGLE"])
  kdpSelectEnrolled     Boolean              @default(false)
  kdpSelectExpiry      DateTime?
  d2dStatus            ExternalStatus       @default(NOT_SENT)
  d2dSentAt            DateTime?
  kdpStatus            ExternalStatus       @default(NOT_SENT)
  kdpSentAt            DateTime?
  googleStatus         ExternalStatus       @default(NOT_SENT)
  googleSentAt         DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  publishedAt          DateTime?
  publicationTimeline  Json?
  manuscriptContent    Json?
  manuscriptImportedAt DateTime?
  manuscriptEditedAt   DateTime? // last author edit inside the manuscript editor (distinct from the initial docx import)
  manuscriptStyleOverrides Json?

  orderItems      OrderItem[]
  royalties       Royalty[]
  conversionJobs  ConversionJob[]

  @@index([authorId])
  @@index([slug])
  @@index([status])
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]
  total     Decimal     @db.Decimal(10, 2)
  status    OrderStatus @default(PENDING)
  paymentId String?
  createdAt DateTime    @default(now())

  @@index([userId])
}

model OrderItem {
  id      String  @id @default(cuid())
  orderId String
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookId  String
  book    Book    @relation(fields: [bookId], references: [id])
  format  String
  price   Decimal @db.Decimal(10, 2)

  @@index([orderId])
}

model Royalty {
  id        String        @id @default(cuid())
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  bookId    String
  book      Book          @relation(fields: [bookId], references: [id])
  amount    Decimal       @db.Decimal(10, 2)
  source    String
  status    RoyaltyStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([authorId])
}

model ConversionJob {
  id        String           @id @default(cuid())
  bookId    String
  book      Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  format    String
  status    ConversionStatus @default(PENDING)
  error     String?
  bullJobId String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([bookId, format])
  @@index([bookId])
}
