generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  AUTHOR
  ADMIN
}

enum BookStatus {
  DRAFT
  PROCESSING
  REVIEW
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DistributionStrategy {
  WIDE
  KDP_SELECT
}

enum ExternalStatus {
  NOT_SENT
  SENT
  PUBLISHED
  ERROR
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

enum RoyaltyStatus {
  PENDING
  PAID
}

enum ConversionStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model User {
  id                           String    @id @default(cuid())
  email                        String    @unique
  passwordHash                 String?
  name                         String
  slug                         String    @unique
  bio                          String?
  avatarUrl                    String?
  role                         Role      @default(AUTHOR)
  emailVerified                Boolean   @default(false)
  emailVerificationToken       String?   @unique
  emailVerificationTokenExpiry DateTime?
  contractAcceptedAt           DateTime?
  contractAcceptedIp           String?
  taxId                        String?
  payoutDocument               String?
  bankIban                     String?
  payoutDetailsSubmittedAt     DateTime?
  firstName                    String?
  lastName                     String?
  patronymic                   String?
  birthDate                    DateTime?
  citizenship                  String?
  registrationAddress          String?
  passportSeries               String?
  identityDocumentUrls         String[]  @default([])
  identityChangeReason         String?
  identityUpdatedAt            DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  books     Book[]
  orders    Order[]
  royalties Royalty[]
  styleSets AuthorStyleSet[]
  coverTemplates CoverTemplate[]

  @@index([slug])
  @@index([email])
}

model AuthorStyleSet {
  id             String   @id @default(cuid())
  authorId       String
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  styleOverrides Json
  createdAt      DateTime @default(now())

  @@index([authorId])
}

// Author-level saved cover design ("Зберегти як шаблон" / "Мої шаблони" in
// CoverDesignerCanvas), reusable across any of the author's books -- distinct
// from AuthorStyleSet (manuscript typography) and from Book.coverDesign
// (per-book live editable state). `design` mirrors the same
// {front, backSpine, background} shape captureDesignState() already
// produces for Book.coverDesign.
model CoverTemplate {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  name      String
  design    Json
  createdAt DateTime @default(now())

  @@index([authorId])
}

model Book {
  id                   String               @id @default(cuid())
  slug                 String               @unique
  title                String
  description          String?
  authorId             String
  author               User                 @relation(fields: [authorId], references: [id])
  status               BookStatus           @default(DRAFT)
  moderationStatus     ModerationStatus     @default(PENDING)
  moderationNote       String?
  rejectedAt           DateTime? // set by admin reject; "коли книжка змінила статус на DRAFT" (admin/books "Дата/час" column) -- distinct from createdAt (a never-submitted DRAFT has no rejectedAt)
  previousStatus       String? // status before soft-delete, restored on undo
  archivedAt           DateTime? // soft-delete timestamp ("Видалити книгу" — recoverable)
  isbn                 String?              @unique
  udcCode              String? // УДК — Universal Decimal Classification index, assigned by Книжкова палата
  bbkCode              String? // ББК — bibliotechno-bibliographic classification index
  authorSign           String? // авторський знак — shelving code, assigned alongside УДК/ББК
  bookChamberSubmittedAt DateTime? // admin marked the book as submitted to Книжкова палата for cataloguing
  copyrightYear        String? // e.g. "2013" -- may predate this book's ULIT createdAt if it was published elsewhere first
  copyrightHolder      String? // © name shown on a prior edition, if different from the account's own display name
  priorPublicationCertificate String? // "Свідоцтво про публікацію №..." from a prior self-publishing platform (proza.ru/stihi.ru etc.)
  coverUrl             String?
  backCoverUrl         String?
  spineUrl             String? // exported crop of the spine panel (softcover/hardcover only) -- used by the 3D preview rotator
  coverImageLibrary    Json? // previously uploaded cover images the author can re-pick — [{url, uploadedAt}]
  coverDesign          Json? // editable cover design state — {front, backSpine, background}, restored into the canvas on next open of /cover (T-1962 sibling; see coverVersion.ts for the exported-PNG cache-busting, this is the separate editable-state save)
  originalDocxUrl      String?
  docxUpdatedAt        DateTime? // set whenever the source .docx changes; compared to publishedAt to know if a live book has unpublished file changes
  republishRequestedAt DateTime? // author submitted post-publish changes for re-moderation; cleared once admin approves or rejects
  pendingTitle         String? // staged edit to title on an already-PUBLISHED book -- same re-moderation model as docxUpdatedAt/originalDocxUrl: live title stays untouched until admin approves via republish, applied then cleared
  pendingDescription   String? // staged edit to description (Анотація), same model as pendingTitle
  pendingGenre         String? // staged edit to genre, same model as pendingTitle
  unpublishedAt        DateTime? // author took the book off sale ("Зняти з публікації"); status=UNPUBLISHED, files/ISBN/publishedAt kept for /relist
  pdfUrl               String?
  epubUrl              String?
  fb2Url               String?
  mobiUrl              String?
  printPdfUrl          String?
  priceEbook           Decimal?             @db.Decimal(10, 2) // Е-книга
  pricePrint           Decimal?             @db.Decimal(10, 2) // Друк, м'яка обкладинка, кольоровий друк
  pricePrintHardcover  Decimal?             @db.Decimal(10, 2) // Друк, тверда обкладинка, кольоровий друк
  pricePrintBw         Decimal?             @db.Decimal(10, 2) // Друк, м'яка обкладинка, чорно-білий друк -- дешевше в типографії
  pricePrintHardcoverBw Decimal?            @db.Decimal(10, 2) // Друк, тверда обкладинка, чорно-білий друк
  genre                String?
  printFormatKey       String? // PrintFormatKey (shared-types) -- auto-set from GENRE_TO_PRINT_FORMAT when genre changes, unless author manually overrode printWidthMm/printHeightMm
  printWidthMm         Int? // actual per-book print trim width -- falls back to PRINT_TRIM_SIZE_MM (shared-types) when null
  printHeightMm        Int? // actual per-book print trim height -- falls back to PRINT_TRIM_SIZE_MM (shared-types) when null
  subtitle             String?
  ageRating            String?
  aiGenerated          Boolean              @default(false)
  aiGeneratedNote      String?
  coAuthors            Json? // legacy/loose field, predates bookAuthors -- kept for backward compat, not used by the new T-2060 "Вихідні дані" redesign
  bookAuthors          Json? // T-2060 п.4 -- structured per-book authors, independent of the account profile: {lastName, firstName, middleName?, photoUrl?}[]
  contributors         Json? // T-2060 п.5 -- "Над книгою працювали" (editor/illustrator/designer etc.), separate entity from bookAuthors: {role, name}[]
  authorBio            String? // T-2060 п.6 -- canonical author biography text, shown on cover (CoverDesignerCanvas) and editable live there when coverIndependentFromBookData is false
  coverIndependentFromBookData Boolean @default(false) // T-2060 п.8 -- when true, cover text (title/author/bio) is edited independently and does NOT sync back to book data
  desiredRoyaltyAmount Decimal?             @db.Decimal(10, 2) // T-2060 п.11 (=T-2053) -- author's desired net earning per unit (E-BOOK). Per-channel retail price is computed from this + each channel's royalty rate, not stored per-channel
  desiredRoyaltyAmountPrint Decimal?        @db.Decimal(10, 2) // T-2075 -- same idea as desiredRoyaltyAmount, but for the PRINT block: production cost (per-book, from print-cost) is added on top before applying each channel's royalty rate, since print has a real per-unit cost the ebook doesn't
  language             String               @default("uk")
  pageCount            Int?
  printPageCount       Int? // page count of the real print-trim PDF (printPdfUrl) -- distinct from pageCount, which is derived from the online-viewer PDF at Word's own page size; used for print-cost estimates
  pagesGeneratedAt     DateTime?
  previewStart         Int?
  previewEnd           Int?
  distributionStrategy  DistributionStrategy @default(WIDE)
  distributionChannels  String[]             @default(["ULIT", "D2D", "KDP", "GOOGLE"])
  kdpSelectEnrolled     Boolean              @default(false)
  kdpSelectExpiry      DateTime?
  d2dStatus            ExternalStatus       @default(NOT_SENT)
  d2dSentAt            DateTime?
  kdpStatus            ExternalStatus       @default(NOT_SENT)
  kdpSentAt            DateTime?
  googleStatus         ExternalStatus       @default(NOT_SENT)
  googleSentAt         DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  publishedAt          DateTime?
  publicationTimeline  Json?
  manuscriptContent    Json?
  manuscriptImportedAt DateTime?
  manuscriptEditedAt   DateTime? // last author edit inside the manuscript editor (distinct from the initial docx import)
  manuscriptStyleOverrides Json?
  printPdfGeneratedAt  DateTime? // T-2057 -- when printPdfUrl was last (re)rendered from manuscriptContent; regen is skipped if this is newer than manuscriptEditedAt

  orderItems      OrderItem[]
  royalties       Royalty[]
  conversionJobs  ConversionJob[]

  @@index([authorId])
  @@index([slug])
  @@index([status])
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]
  total     Decimal     @db.Decimal(10, 2)
  status    OrderStatus @default(PENDING)
  paymentId String?
  createdAt DateTime    @default(now())

  @@index([userId])
}

model OrderItem {
  id      String  @id @default(cuid())
  orderId String
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookId  String
  book    Book    @relation(fields: [bookId], references: [id])
  format  String
  // Which ebook file formats (EPUB/FB2/MOBI) the buyer chose to receive --
  // only meaningful when format == "EBOOK". Empty means "all available"
  // (covers orders placed before this field existed).
  formats String[] @default([])
  price   Decimal @db.Decimal(10, 2)

  @@index([orderId])
}

model Royalty {
  id        String        @id @default(cuid())
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  bookId    String
  book      Book          @relation(fields: [bookId], references: [id])
  amount    Decimal       @db.Decimal(10, 2)
  source    String
  status    RoyaltyStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([authorId])
}

model ConversionJob {
  id        String           @id @default(cuid())
  bookId    String
  book      Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  format    String
  status    ConversionStatus @default(PENDING)
  error     String?
  bullJobId String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([bookId, format])
  @@index([bookId])
}

// Single-row platform-wide print production cost config, edited from
// /admin/settings/print-cost. Not per-book -- print trim size is fixed
// platform-wide (see CoverDesignerCanvas.tsx), so one cost formula applies
// to every book: baseCost(cover type) + printPageCount * costPerPage.
model PrintCostSettings {
  id                String   @id @default("singleton")
  baseCostSoftcover Decimal  @db.Decimal(10, 2) // тираж = 1 (за замовчуванням для більшості авторів)
  baseCostHardcover Decimal  @db.Decimal(10, 2)
  costPerPage       Decimal  @db.Decimal(10, 4)
  // Optional volume-discount steps for larger print runs (тираж), beyond the
  // single-copy defaults above -- [{minQuantity, baseCostSoftcover,
  // baseCostHardcover, costPerPage}], sorted by minQuantity ascending. Empty
  // by default; most authors print one copy at a time and never need this.
  bulkTiers         Json     @default("[]")
  updatedAt         DateTime @updatedAt
}
